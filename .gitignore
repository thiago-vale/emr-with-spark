# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# Ignore lock file - comment out if you want to track it
.terraform.lock.hcl

# Ignore Lambda package file
lambda_function_payload.zip

# Ignore package directory
package/

# OS files
.DS_Store
.vscode/
*.swp
*.swo
*~
